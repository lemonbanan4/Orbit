AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=eur3
DEFAULT_FROM=Orbit <contact@orbitroutine.com>
DEFAULT_REPLY_TO=contact@orbitroutine.com
firebaseextensions.v1beta.function/location=europe-west3
firebaseextensions.v1beta.function/minInstances=0
firebaseextensions.v1beta.function/vpcConnectorEgressSettings=VPC_CONNECTOR_EGRESS_SETTINGS_UNSPECIFIED
firebaseextensions.v1beta.v2function/memory=256Mi
MAIL_COLLECTION=mail
OAUTH_PORT=465
OAUTH_SECURE=true
REFRESH_TOKEN=projects/${param:PROJECT_NUMBER}/secrets/firestore-send-email-REFRESH_TOKEN/versions/latest
TEMPLATES_COLLECTION=email_templates
TTL_EXPIRE_TYPE=day
TTL_EXPIRE_VALUE=2592000
USERS_COLLECTION=users