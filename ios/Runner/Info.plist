	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Orbit needs camera access so the AI Lens can suggest a habit from a photo.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>We need access to your microphone so you can speak your goals to the Routine Genie.</string>
