// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId}
// Fields: current_streak, xp, avatar, displayName, routine_alarms, habits, etc.
//
// Subcollections:
//   - habits/{habitId}
//   - skipped_sessions/{sessionId}
//   - notifications/{notificationId}
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      let allowedKeys = [
        'routine_rewards', 'routine_alarms', 'habits', 'current_streak', 
        'streak_increased_today', 'longest_streak', 'total_habits_assigned',
        'total_habits_completed',
        'xp', 'avatar', 'mood_history', 'xp_history', 'displayName',
        'intention_history', 'unlocked_journey_chapters', 'unlocked_milestones', 
        'audio_track', 'ambient_volume', 'last_updated', 'bookmarked_quotes', 
        'unlocked_reader_badge', 'unlocked_themes', 'active_nebula_theme',
        'all_notifs', 'daily_summary_notifs', 'morning_notifs', 'night_notifs', 'interests',
        'email', 'onboarding_completed_at', 'survey_answers',
        'isGuest', 'createdAt', 'streakCount', 'completedMilestones',
        'achievements', 'name', 'photoUrl', 'fcmToken', 'friends',
        'fairy_taps', 'unlocked_fairy_badge', 'global_xp', 'current_level',
        'wisdomStreak', 'lastWisdomDate', 'streakFreezes', 'isStreakFrozen',
        // Server-only (Admin SDK, bypasses these rules) -- kept in
        // allowedKeys for the same reason as 'friends' above: hasOnly()
        // checks the full *resulting* merged document, so once any of
        // these lands on a user's doc (RevenueCat webhook, referral
        // redemption, retention-email cron, email-open tracking pixel),
        // every subsequent client merge-write via _saveToCloud() would
        // otherwise be silently rejected forever.
        'isPro', 'willRenew', 'proExpirationDate', 'retentionEmailSent',
        'referredBy', 'hasReadWarningEmail', 'warningEmailOpenedAt',
        'emailTrackingToken', 'featured_habit_id'
      ];

      // Prevent 1MB string payload attacks on display name — 'name' is
      // the field actually shown/edited in the app (profile, leaderboard,
      // settings); 'displayName' is a separate FirebaseAuth-mirrored
      // field. Both need the same guard. featured_habit_id is grouped in
      // here too (rather than its own `let`) purely to stay under
      // Firestore's 10-variable-per-function limit -- it's cleared via
      // FieldValue.delete() (see setFeaturedHabit), never written as an
      // explicit null, so it only ever needs to accept "absent" or "a
      // real habit ID string."
      let isMiscFieldsValid =
        (!('displayName' in data) || isValidString(data.displayName, 0, 60)) &&
        (!('name' in data) || isValidString(data.name, 0, 60)) &&
        (!('featured_habit_id' in data) || isValidString(data.featured_habit_id, 0, 100));

      // Anti-cheat: every economy/progression field here was previously
      // unvalidated beyond its key being allowlisted -- a client could set
      // xp/streakFreezes/current_level etc. to any value or type via a
      // direct Firestore SDK write, fully bypassing buyStreakFreeze's and
      // unlockNebulaTheme's server-side cost checks. These bounds are
      // deliberately generous (this isn't meant to model exact game
      // balance) -- they only block wrong-typed, negative, or wildly
      // out-of-range writes.
      let isXpValid = !('xp' in data) || (data.xp is int && data.xp >= 0 && data.xp <= 100000000);
      let isGlobalXpValid = !('global_xp' in data) || (data.global_xp is int && data.global_xp >= 0 && data.global_xp <= 1000000);
      let isCurrentLevelValid = !('current_level' in data) || (data.current_level is int && data.current_level >= 1 && data.current_level <= 100000);
      let isCurrentStreakValid = !('current_streak' in data) || (data.current_streak is int && data.current_streak >= 0 && data.current_streak <= 100000);
      let isLongestStreakValid = !('longest_streak' in data) || (data.longest_streak is int && data.longest_streak >= 0 && data.longest_streak <= 100000);
      let isTotalCompletedValid = !('total_habits_completed' in data) || (data.total_habits_completed is int && data.total_habits_completed >= 0 && data.total_habits_completed <= 100000000);
      let isStreakFreezesValid = !('streakFreezes' in data) || (data.streakFreezes is int && data.streakFreezes >= 0 && data.streakFreezes <= 10000);
      let isUnlockedThemesValid = !('unlocked_themes' in data) || (data.unlocked_themes is list && data.unlocked_themes.size() <= 100);
      let isAchievementsValid = !('achievements' in data) || (data.achievements is list && data.achievements.size() <= 500);

      return data.keys().hasOnly(allowedKeys) && isMiscFieldsValid &&
        isXpValid && isGlobalXpValid && isCurrentLevelValid && isCurrentStreakValid &&
        isLongestStreakValid && isTotalCompletedValid && isStreakFreezesValid &&
        isUnlockedThemesValid && isAchievementsValid;
    }

    // Guests (isGuest: true, typically anonymous-auth accounts) must not be
    // able to rewrite their own streakCount — that's the anti-cheat field
    // read on public-facing surfaces like the leaderboard and profile screen.
    function isGuestStreakTamper() {
      return resource.data.isGuest == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['streakCount']);
    }

    // 'friends' is only ever written server-side (Admin SDK, which bypasses
    // these rules entirely) by notifyOnFriendRequestAccepted/removeFriend/
    // cleanupUserAccount -- nothing in the Flutter app writes it directly.
    // It stays in isValidUser's allowedKeys so existing docs that already
    // have it can still pass normal client merge-writes (hasOnly() checks
    // the full *resulting* merged document, not just this write's delta),
    // but a client actively touching it here would let it forge a
    // one-sided "friendship" with anyone and read their data via the
    // leaderboard's users-where-in-friends query with no request/accept
    // step at all.
    function isFriendsTamper() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['friends']);
    }

    function isValidHabit(data) {
      // Keys must match Habit.toMap() in lib/models/habit.dart exactly —
      // note the field is 'routine', not 'routineType' (Habit.fromMap()
      // reads 'routine' too; this allowlist previously didn't match either
      // side of the app's own model, so every addHabit() call was rejected).
      let allowedKeys = ['id', 'title', 'routine', 'iconCodePoint', 'color',
        'completedDays', 'totalDays', 'order', 'skippedCount', 'time', 'isCompleted',
        'history', 'isGoal', 'category', 'activeDays', 'targetCount', 'unit',
        'currentCount', 'isArchived', 'remindersEnabled', 'reminderTime', 'note',
        'weeklyTarget', 'healthMetric', 'healthTarget', 'isNegativeHabit'];
      // Which days of the week this habit is due (see Habit.activeDays) --
      // must be exactly 7 booleans if present at all.
      let isActiveDaysValid = !('activeDays' in data) ||
        (data.activeDays is list && data.activeDays.size() == 7);
      // Count-based habits ("Drink 8 glasses of water") -- see
      // Habit.targetCount/unit/currentCount.
      let isTargetCountValid = !('targetCount' in data) ||
        (data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 9999);
      let isUnitValid = !('unit' in data) || isValidString(data.unit, 0, 30);
      // Shared by count-based habits' currentCount (targetCount capped at
      // 9999 above) and health-linked habits' live steps/minutes progress
      // (healthTarget capped at 1000000 below) -- bounded to the larger of
      // the two so a high step-count target doesn't get rejected.
      let isCurrentCountValid = !('currentCount' in data) ||
        (data.currentCount is int && data.currentCount >= 0 && data.currentCount <= 1000000);
      // isNegativeHabit ("quit"/avoid habits, see Habit.isNegativeHabit) is
      // grouped in here too, purely to stay under Firestore's
      // 10-variable-per-function limit -- both are plain bool flags.
      let isArchivedValid = (!('isArchived' in data) || data.isArchived is bool) &&
        (!('isNegativeHabit' in data) || data.isNegativeHabit is bool);
      let isRemindersValid =
        (!('remindersEnabled' in data) || data.remindersEnabled is bool) &&
        (!('reminderTime' in data) || isValidString(data.reminderTime, 3, 5));
      // Optional per-habit motivation note (see Habit.note).
      let isNoteValid = !('note' in data) || isValidString(data.note, 0, 500);
      // Flexible "N times per week" scheduling (see Habit.weeklyTarget): 1..7.
      let isWeeklyTargetValid = !('weeklyTarget' in data) ||
        (data.weeklyTarget is int && data.weeklyTarget >= 1 && data.weeklyTarget <= 7);
      // Health-linked habits (see Habit.healthMetric/healthTarget) — progress
      // comes from HealthSyncService (device Health Connect/HealthKit data),
      // not a manual tap, so the metric is restricted to the two types the
      // app actually syncs and the target just needs a sane positive bound.
      let isHealthMetricValid = !('healthMetric' in data) ||
        data.healthMetric in ['steps', 'workout_minutes'];
      let isHealthTargetValid = !('healthTarget' in data) ||
        (data.healthTarget is int && data.healthTarget >= 1 && data.healthTarget <= 1000000);
      return data.keys().hasOnly(allowedKeys) &&
             isValidString(data.title, 1, 100) &&
             isValidString(data.routine, 1, 50) &&
             isActiveDaysValid && isTargetCountValid && isUnitValid &&
             isCurrentCountValid && isArchivedValid && isRemindersValid &&
             isNoteValid && isWeeklyTargetValid &&
             isHealthMetricValid && isHealthTargetValid;
    }

    function isValidJournalEntry(data) {
      let allowedKeys = ['content', 'timestamp', 'sourceCategory'];
      return data.keys().hasOnly(allowedKeys) &&
             isValidString(data.content, 0, 10000);
    }

    function isValidAiCache(data) {
      // ai_coach_service.dart caches two different things under this
      // subcollection ('ai_insight' and 'daily_intention' docs), each with
      // a slightly different shape — allow the union of both.
      let allowedKeys = ['stateKey', 'insight', 'intention', 'timestamp'];
      return data.keys().hasOnly(allowedKeys) && data.stateKey is string;
    }

    function isValidFairyHistoryEntry(data) {
      let allowedKeys = ['context', 'fairyMessage', 'userReply', 'timestamp'];
      // Unlike every other validator in this file, this one had zero
      // length/type bounds -- fairy_history is create-only/immutable (see
      // below), so with no cap a client could repeatedly append near-
      // unbounded string payloads with no way to ever clean them up.
      return data.keys().hasOnly(allowedKeys) &&
             isValidString(data.context, 0, 200) &&
             isValidString(data.fairyMessage, 0, 2000) &&
             isValidString(data.userReply, 0, 500);
    }

    function isValidSkippedSession(data) {
      // 'habitTitle' is read by skipped_sessions_screen.dart but was
      // missing from this allowlist — any write including it (which is
      // the only way the screen can show anything meaningful) was always
      // rejected outright.
      let allowedKeys = ['timestamp', 'reason', 'habitTitle'];
      return data.keys().hasOnly(allowedKeys) &&
             isValidString(data.reason, 0, 500) &&
             isValidString(data.habitTitle, 1, 100);
    }

    function isValidConstellationWeek(w) {
      let allowedKeys = ['week', 'habitTitle', 'icon', 'routine', 'description', 'habitId'];
      return w.keys().hasOnly(allowedKeys) &&
             w.week is int && w.week >= 1 && w.week <= 4 &&
             isValidString(w.habitTitle, 1, 100) &&
             isValidString(w.icon, 1, 30) &&
             isValidString(w.routine, 1, 20) &&
             isValidString(w.description, 0, 300) &&
             (!('habitId' in w) || isValidString(w.habitId, 1, 200));
    }

    // A "Constellation" is a persisted AI-generated 4-week habit roadmap
    // (see lib/models/constellation.dart) -- always exactly 4 weeks, each
    // individually shape-checked above.
    function isValidConstellation(data) {
      let allowedKeys = ['goal', 'habits', 'currentWeek', 'status', 'createdAt'];
      return data.keys().hasOnly(allowedKeys) &&
             isValidString(data.goal, 1, 200) &&
             data.habits is list && data.habits.size() == 4 &&
             isValidConstellationWeek(data.habits[0]) &&
             isValidConstellationWeek(data.habits[1]) &&
             isValidConstellationWeek(data.habits[2]) &&
             isValidConstellationWeek(data.habits[3]) &&
             data.currentWeek is int && data.currentWeek >= 1 && data.currentWeek <= 4 &&
             data.status in ['active', 'completed', 'abandoned'] &&
             data.createdAt is timestamp;
    }

    function isValidCoachingNote(data) {
      let allowedKeys = ['text', 'createdAt', 'mood'];
      return data.keys().hasOnly(allowedKeys) &&
             isValidString(data.text, 0, 2000) &&
             (!('mood' in data) || isValidString(data.mood, 0, 30));
    }

    function isValidFriendRequest(data) {
      let allowedKeys = ['senderId', 'senderName', 'status', 'timestamp'];
      return data.keys().hasOnly(allowedKeys) &&
             isValidString(data.senderName, 0, 60) &&
             data.status is string;
    }

    // A participant's own daily check-in record within a group Challenge
    // (see lib/models/challenge.dart) -- {date: true} entries, one per day
    // they showed up. Not deeply validated key-by-key (Firestore rules
    // can't cheaply iterate a map's values) -- matches the existing
    // precedent of Habit.history, which is allowlisted but not
    // per-entry-validated either. size() is capped generously above the
    // longest challenge duration (30 days) as a sanity bound, not an
    // attempt at exact validation.
    function isValidChallengeProgress(data) {
      return data.keys().hasOnly(['checkins']) &&
             data.checkins is map &&
             data.checkins.size() <= 40;
    }

    // ===============================================================
    // Collections
    // ===============================================================

    match /users/{userId} {
      // Strict isolation: Users can only read and write their own primary document
      allow read, delete: if isOwner(userId);
      // 'friends' is never part of a legitimate initial account-creation
      // payload (see auth_service.dart's _ensureUserDocument) -- it's only
      // ever added later via a Cloud Function's arrayUnion. resource
      // doesn't exist yet on create, so isFriendsTamper()'s diff() isn't
      // usable here; check directly instead.
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
        !('friends' in request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
        !isGuestStreakTamper() && !isFriendsTamper();

      match /habits/{habitId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidHabit(request.resource.data);
      }

      match /constellations/{constellationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidConstellation(request.resource.data);
      }

      match /journal_entries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidJournalEntry(request.resource.data);
      }

      match /cache/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAiCache(request.resource.data);
      }

      match /fairy_history/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFairyHistoryEntry(request.resource.data);
        allow update, delete: if false; // immutable history log
      }

      match /skipped_sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSkippedSession(request.resource.data);
      }

      match /coaching_notes/{noteId} {
        // Had no rule at all — every write from coaching_session_screen.dart
        // (a reflection note + mood, submitted at the end of a coaching
        // session) and every read from mood_chart_widget.dart's "Recent
        // Mood Analysis" card on the Stats screen fell through to the
        // default-deny catch-all below. The write was silently swallowed
        // (caught, debugPrint only), so this has never worked for anyone.
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCoachingNote(request.resource.data);
      }

      match /notifications/{notificationId} {
        // Notifications are created server-side only (Cloud Functions via
        // the Admin SDK, which bypasses these rules) -- the client never
        // creates one, it only reads, marks isArchived, and bulk-deletes on
        // reset. This used to allow bare `write`, so any signed-in user
        // could `set()`/`add()` arbitrarily-shaped, unbounded docs straight
        // into their own notifications subcollection via the SDK directly
        // (not through the app UI), unlike every other subcollection here.
        allow read, delete: if isOwner(userId);
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isArchived']) &&
          request.resource.data.isArchived is bool;
      }

      match /friend_requests/{requestId} {
        // The recipient (owner) can see and decline their own incoming requests,
        // and mark one as accepted (nothing else about it is client-editable —
        // the mutual friends-list write happens server-side in the
        // notifyOnFriendRequestAccepted Cloud Function via the Admin SDK).
        allow read, delete: if isOwner(userId);
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'accepted';

        // Anyone can send a request to another user's subcollection, but only
        // as themselves (the doc ID must be their own uid) and only pending.
        allow create: if isAuthenticated() &&
          request.auth.uid == requestId &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          isValidFriendRequest(request.resource.data);
      }
    }

    // Let users send emails via the Firebase Trigger Email Extension
    match /mail/{document} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // Admin-managed wisdom quote content shown in the Sanctuary's Sacred
    // Scroll feature. Read-only for signed-in users; never client-writable.
    match /wisdom_library/{document} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Group Challenges: a time-boxed shared commitment among mutual friends
    // (see lib/models/challenge.dart). Lives as a top-level collection
    // (like `links`) rather than nested under users/{userId} because it's
    // genuinely shared across multiple UIDs, not owned by one user.
    match /challenges/{challengeId} {
      // Only participants can see a challenge exists at all (privacy --
      // non-participants shouldn't be able to read who's in it or its
      // title/goal). Creation only ever happens server-side (the
      // createChallenge Cloud Function) since it needs to verify every
      // invitee is a mutual friend of the creator -- something rules can't
      // cheaply check across two different users' documents.
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;

      match /progress/{uid} {
        // Any participant of the parent challenge can read everyone's
        // check-ins (needed for the shared leaderboard); only the owning
        // participant can write their own.
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/challenges/$(challengeId)).data.participantIds;
        allow create, update: if isOwner(uid) &&
          request.auth.uid in get(/databases/$(database)/documents/challenges/$(challengeId)).data.participantIds &&
          isValidChallengeProgress(request.resource.data);
        allow delete: if false;
      }
    }

    // Global deny for everything else (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}